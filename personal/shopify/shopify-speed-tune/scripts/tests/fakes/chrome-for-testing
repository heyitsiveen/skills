#!/usr/bin/env python3
"""Stand-in Chrome for Testing, which the fake pnpm installs: a browser that only waits.

Like the real one started with `--remote-debugging-port=0`, it picks a port and
writes it to DevToolsActivePort in its profile. It registers that port in the
sandbox's `chromes/` folder, with its pid and profile, so the fake `node` and
the fake Lighthouse can tell a running browser from a stopped one and keep its
cookie jar there. Then it waits until the program stops it.

It holds the program to the contract: a throwaway profile, a free port, the
headless flag, and no cookie on its command line.
"""

import json
import os
import re
import sys
import time

args = sys.argv[1:]
sandbox = os.path.dirname(os.environ["FAKE_STORE"])


def fail(message):
    sys.stderr.write(message + "\n")
    sys.exit(1)


def value(name):
    for a in args:
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


if any(re.search(r"fake-\d+-cookie", a) for a in args):
    fail("fake chrome: a cookie on the command line shows in `ps`")
if "--headless=new" not in args:
    fail("fake chrome: started without --headless=new, it would open a window")
if value("--remote-debugging-port") != "0":
    fail("fake chrome: a fixed debugging port can collide with another session's Chrome")
profile = value("--user-data-dir")
if not profile or not os.path.isdir(profile):
    fail("fake chrome: no throwaway --user-data-dir, so it would use the developer's profile")

port = 20000 + os.getpid() % 40000
registry = os.path.join(sandbox, "chromes")
os.makedirs(registry, exist_ok=True)
with open(os.path.join(registry, str(port)), "w", encoding="utf-8") as f:
    json.dump({"pid": os.getpid(), "profile": profile}, f)
with open(os.path.join(profile, "DevToolsActivePort"), "w", encoding="utf-8") as f:
    f.write("%d\n/devtools/browser/fake\n" % port)
time.sleep(120)
