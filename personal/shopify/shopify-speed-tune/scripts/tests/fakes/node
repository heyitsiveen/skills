#!/usr/bin/env python3
"""Fake `node` for the decision program's tests: the browser helper.

- `jar.mjs --port <p> --store <url>` puts the cookie it reads on stdin in the
  jar of the stand-in Chrome at that port, for the store's host.

It holds the program to the contract: puppeteer-core installed in the
workspace project, a running Chrome at the port, and the cookie on stdin, never
on the command line.
"""

import json
import os
import re
import sys
from urllib.parse import urlsplit

with open(os.environ["FAKE_STORE"], encoding="utf-8") as f:
    store = json.load(f)
registry = os.path.join(os.path.dirname(os.environ["FAKE_STORE"]), "chromes")


def fail(message):
    sys.stderr.write(message + "\n")
    sys.exit(1)


if len(sys.argv) < 2:
    fail("fake node: no script")
script, rest = os.path.basename(sys.argv[1]), sys.argv[2:]
if any(re.search(r"fake-\d+-cookie", a) for a in rest):
    fail("fake node: a cookie on the command line shows in `ps`")
options = dict(zip(rest[::2], rest[1::2]))
project = os.environ.get("SPEED_TUNE_NODE_PROJECT", "")
if not os.path.isfile(os.path.join(project, "node_modules", "puppeteer-core", "package.json")):
    fail("Cannot find package 'puppeteer-core' from %r" % project)

port = options.get("--port", "")
try:
    with open(os.path.join(registry, port), encoding="utf-8") as f:
        chrome = json.load(f)
    os.kill(chrome["pid"], 0)
except (OSError, ValueError, KeyError):
    fail("Failed to fetch browser webSocket URL from http://127.0.0.1:%s/json/version" % port)


def theme_of(cookie):
    found = re.match(r"_shopify_essential=fake-(\d+)-cookie$", cookie or "")
    return int(found.group(1)) if found else None


if script == "jar.mjs":
    cookie = sys.stdin.read().strip()
    if theme_of(cookie) is None:
        fail("the preview cookie is not a name=value pair")
    host = urlsplit(options["--store"]).hostname
    with open(os.path.join(registry, port + ".jar"), "w", encoding="utf-8") as f:
        json.dump({"host": host, "cookie": cookie}, f)
    print("JAR %s" % host)
    sys.exit(0)

fail("fake node: unexpected script %r" % script)
